<?php

$tmaid = $this->match->need('tmaid');

$backUrl = $this->url('backend/tournament/matches-result', ['tmaid' => $tmaid]);

$this->setup(array(
    'title' => 'Reset this result',
    'panel' => 'centered-panel',
    'back' => array(
        'Result' => $backUrl,
    ),
));

?>

<div class="padded centered-text">
    <p><span class="symbolic symbolic-warning">
        <?= sprintf(
            $this->t('Are you sure you want to reset the result of %s vs %s? The set scores will be deleted and the match will go back to scheduled.'),
            $this->userA ? $this->escapeHtml($this->userA->get('alias')) : $this->t('this player'),
            $this->userB ? $this->escapeHtml($this->userB->get('alias')) : $this->t('this player')
        ) ?>
    </span></p>

    <p class="no-wrap">
        <a href="<?= $this->url('backend/tournament/matches-reset', ['tmaid' => $tmaid], ['query' => ['confirmed' => 'true']]) ?>" class="default-button">
            <span class="symbolic symbolic-cross"><?= $this->t('Yes, reset this result') ?></span>
        </a>

        &nbsp;

        <a href="<?= $backUrl ?>" class="default-button"><?= $this->t('No, go back') ?></a>
    </p>
</div>
