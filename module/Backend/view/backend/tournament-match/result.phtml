<?php

$tmaid = $this->match->need('tmaid');

$this->setup(array(
    'title' => 'Tournament-Administration',
    'panel' => 'centered-panel',
    'back' => array(
        'Matches' => $this->url('backend/tournament/matches', ['tcid' => $this->match->need('tcid')]),
    ),
));

?>

<div>
    <h1>
        <?= $this->userA ? $this->escapeHtml($this->userA->get('alias')) : $this->t('Unknown user') ?>
        <?= $this->t('vs') ?>
        <?= $this->userB ? $this->escapeHtml($this->userB->get('alias')) : $this->t('Unknown user') ?>
    </h1>

    <div class="separator-small"></div>

    <div class="padded">
        <?php

        $form = $this->resultForm;
        $form->setAttribute('method', 'post');
