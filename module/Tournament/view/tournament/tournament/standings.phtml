<?php

$this->setup(array(
    'title' => 'Standings',
    'panel' => 'centered-panel large-sized',
    'back' => array(
        'Tournament' => $this->url('tournament/view', ['tid' => $this->tournament->need('tid')]),
    ),
));

?>

<div>
    <h1><?= $this->escapeHtml($this->tournament->getMeta('name', $this->t('Tournament'))) ?> &middot; <?= $this->t($this->category->getGender()) ?></h1>

    <div class="separator-small"></div>

    <?php if (empty($this->groups)): ?>

        <p><?= $this->t('The draw has not been made yet.') ?></p>

    <?php endif; ?>

    <?php foreach ($this->groups as $group): ?>

        <?php $tgid = $group->need('tgid'); ?>

        <h2><?= $this->escapeHtml($group->need('label')) ?></h2>

        <div class="table-scroll">
            <table class="default-table">
                <tr>
                    <th>#</th>
                    <th><?= $this->t('Player') ?></th>
                    <th><?= $this->t('Wins') ?></th>
                    <th><?= $this->t('Losses') ?></th>
                    <th><?= $this->t('Sets') ?></th>
                    <th><?= $this->t('Games') ?></th>
                </tr>

                <?php foreach ($this->standingsByGroup[$tgid] ?? [] as $row): ?>
                    <?php $user = $this->users[$row['tpid']] ?? null; ?>
                    <tr>
                        <td><?= $row['rank'] ?></td>
                        <td><?= $user ? $this->escapeHtml($user->get('alias')) : $this->t('Unknown user') ?></td>
                        <td><?= $row['wins'] ?></td>
                        <td><?= $row['losses'] ?></td>
                        <td><?= $row['setsWon'] ?>:<?= $row['setsLost'] ?></td>
                        <td><?= $row['gamesWon'] ?>:<?= $row['gamesLost'] ?></td>
                    </tr>
                <?php endforeach; ?>
            </table>
        </div>

        <?php $playedMatches = $this->playedMatchesByGroup[$tgid] ?? []; ?>

        <?php if ($playedMatches): ?>

            <div class="separator-small"></div>

            <h3><?= $this->t('Played matches') ?></h3>

            <div class="table-scroll">
                <table class="default-table">
                    <?php foreach ($playedMatches as $match): ?>
                        <?php
                        $userA = $this->users[$match->get('player_a_tpid')] ?? null;
                        $userB = $this->users[$match->get('player_b_tpid')] ?? null;
                        $winnerTpid = $match->get('winner_tpid');
                        ?>
                        <tr>
                            <td>
                                <?php if ($winnerTpid == $match->get('player_a_tpid')): ?><b><?php endif; ?>
                                <?= $userA ? $this->escapeHtml($userA->get('alias')) : $this->t('Unknown user') ?>
                                <?php if ($winnerTpid == $match->get('player_a_tpid')): ?></b><?php endif; ?>
                            </td>
                            <td><?= $this->t('vs') ?></td>
                            <td>
                                <?php if ($winnerTpid == $match->get('player_b_tpid')): ?><b><?php endif; ?>
                                <?= $userB ? $this->escapeHtml($userB->get('alias')) : $this->t('Unknown user') ?>
                                <?php if ($winnerTpid == $match->get('player_b_tpid')): ?></b><?php endif; ?>
                            </td>
                            <td class="gray"><?= $this->escapeHtml($this->matchScores[$match->need('tmaid')] ?? '') ?></td>
                        </tr>
                    <?php endforeach; ?>
                </table>
            </div>

        <?php endif; ?>

        <div class="separator separator-line"></div>

    <?php endforeach; ?>

</div>
